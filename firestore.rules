rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access to any document in the database
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------------
    // User Root Document (/users/{userId})
    // Stores profile, user preferences, and aggregated physical stats
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if isOwner(userId);

      // ----------------------------------------------------------------------
      // Workouts Subcollection (/users/{userId}/workouts/{workoutId})
      // ----------------------------------------------------------------------
      match /workouts/{workoutId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------------------------------------
      // Custom Routines Subcollection (/users/{userId}/customRoutines/{routineId})
      // ----------------------------------------------------------------------
      match /customRoutines/{routineId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------------------------------------
      // Wellness Journals Subcollection (/users/{userId}/journals/{journalId})
      // ----------------------------------------------------------------------
      match /journals/{journalId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------------------------------------
      // Meal Logs Subcollection (/users/{userId}/meals/{mealId})
      // ----------------------------------------------------------------------
      match /meals/{mealId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ----------------------------------------------------------------------
      // Coach Chat Messages Subcollection (/users/{userId}/coaches/{coachId}/messages/{messageId})
      // ----------------------------------------------------------------------
      match /coaches/{coachId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
