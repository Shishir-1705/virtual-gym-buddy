# =============================================================================
# VIRTUAL GYM BUDDY — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT:
# - Server-side variables (GEMINI_API_KEY, FIREBASE_ADMIN_*, etc.) are SECRET.
#   Never prefix server-side variables with VITE_ or expose them to client code.
# - Client-side variables (prefixed with VITE_) are embedded directly into the
#   browser JavaScript bundle at build time by Vite. They MUST NOT contain secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER SECRETS & AI CONFIGURATION (Server-Side Only - Private)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls (/api/buddy/*).
# In Google AI Studio, this is automatically injected into the environment.
# In self-hosted or container deployments (Cloud Run, Render, Railway), configure
# this in your hosting provider's Secret Manager or Environment Variables panel.
GEMINI_API_KEY="your-gemini-api-key"

# -----------------------------------------------------------------------------
# 2. SERVER OPERATIONAL & HOSTING SETTINGS (Server-Side Only)
# -----------------------------------------------------------------------------
# NODE_ENV: Set to "production" in production environments.
# Controls static asset serving, HSTS enforcement, and error detail masking.
NODE_ENV="development"

# PORT: The port the Express HTTP server binds to (default: 3000).
# Cloud Run and other PaaS providers automatically provide this via environment.
PORT="3000"

# TRUST_PROXY: Set to "true" or "1" when deploying behind a reverse proxy or
# load balancer (e.g. Google Cloud Run, Cloudflare, Render, AWS ALB).
# Enables Express to extract real client IP addresses for rate limiting.
TRUST_PROXY="false"

# ENABLE_HSTS: Set to "true" in production when HTTPS is terminated directly
# or by your edge CDN to enable Strict-Transport-Security headers (1 year max-age).
ENABLE_HSTS="false"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins for cross-origin API calls.
# In standard unified deployments where Express serves both frontend and API from
# the same domain, leave this empty. Example: "https://gymbuddy.example.com"
ALLOWED_ORIGINS=""

# APP_URL: Optional canonical URL where this applet is hosted.
# Used for self-referential links and OAuth redirects where applicable.
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK CONFIGURATION (Server-Side Only - Private)
# -----------------------------------------------------------------------------
# FIREBASE_PROJECT_ID: The Firebase project ID for server-side token verification.
# When using Google Cloud Run or GCP with Application Default Credentials (ADC),
# service account keys are NOT required if the service account has Firebase Admin rights.
FIREBASE_PROJECT_ID="your-firebase-project-id"

# In non-GCP hosting (e.g. Render, Railway, VPS), provide service account credentials via:
# Option 1: Direct Environment Variables:
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Option 2: Render Secret File Path (or GOOGLE_APPLICATION_CREDENTIALS):
# FIREBASE_SERVICE_ACCOUNT_PATH="/etc/secrets/firebase-service-account.json"

# -----------------------------------------------------------------------------
# 4. SERVER-SIDE RATE LIMITING CONFIGURATION (AI Endpoints /api/buddy/*)
# -----------------------------------------------------------------------------
# In-memory sliding rate limiters to control Gemini AI API consumption.
# Note: In-memory store applies per server process. For multi-instance horizontal
# scaling, see docs/PRODUCTION_DEPLOYMENT.md for Redis store setup.
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_GUEST_MAX="10"
RATE_LIMIT_AUTH_MAX="60"

# -----------------------------------------------------------------------------
# 5. FIREBASE CLIENT CONFIGURATION (Public - Embedded in Browser Bundle)
# -----------------------------------------------------------------------------
# Public Firebase Web Client credentials obtained from Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# When omitted, Virtual Gym Buddy runs seamlessly in offline Guest Mode.
VITE_FIREBASE_API_KEY="AIzaSyYourClientApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# -----------------------------------------------------------------------------
# 6. LOCAL DEVELOPMENT & EMULATOR SETTINGS (Development / Testing Only)
# -----------------------------------------------------------------------------
# Set VITE_USE_FIREBASE_EMULATOR="true" only when developing locally with the
# Firebase Emulator Suite (`firebase emulators:start`).
# MUST BE SET TO "false" IN PRODUCTION!
VITE_USE_FIREBASE_EMULATOR="false"
VITE_FIREBASE_AUTH_EMULATOR_HOST="http://127.0.0.1:9099"
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST="127.0.0.1"
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT="8080"

# Server-side emulator connection for local testing:
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
